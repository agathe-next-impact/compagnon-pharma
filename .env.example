# ─── Neon Postgres ──────────────────────────────────────────────
# Connection string Neon. Utilisez de préférence l'endpoint POOLED
# (le hostname contient "-pooler") pour Vercel serverless.
# Format : postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ─── Payload ────────────────────────────────────────────────────
# Secret aléatoire (>= 32 caractères) utilisé pour signer les sessions.
# Générez-en un avec : `openssl rand -base64 48`
PAYLOAD_SECRET=replace-with-a-long-random-secret-min-32-chars

# URL publique de l'API (sera utilisée pour CORS/CSRF).
# En dev : http://localhost:3000 — en prod : https://votre-domaine.vercel.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Seed admin initial (optionnel) ─────────────────────────────
# Si renseignés, un utilisateur admin sera créé au premier démarrage
# si aucun compte avec cet email n'existe encore.
ADMIN_EMAIL=admin@karinthi.fr
ADMIN_PASSWORD=changez-ce-mot-de-passe
